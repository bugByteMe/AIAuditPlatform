# Replace audit.example.com and the certificate paths before enabling this site.
upstream ai_audit_control_plane {
  server 127.0.0.1:8000;
  keepalive 32;
}

server {
  listen 80;
  listen [::]:80;
  server_name audit.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name audit.example.com;

  ssl_certificate /etc/letsencrypt/live/audit.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/audit.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  location = /api/payments/wechat/notify {
    limit_except POST { deny all; }
    client_max_body_size 64k;
    proxy_pass http://ai_audit_control_plane;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }

  location ~ ^/api/workspaces/[^/]+/chat/stream$ {
    proxy_pass http://ai_audit_control_plane;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }

  location /api/uploads/ {
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_pass http://ai_audit_control_plane;
    proxy_http_version 1.1;
    proxy_read_timeout 360s;
    proxy_send_timeout 360s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }

  location / {
    client_max_body_size 16m;
    proxy_pass http://ai_audit_control_plane;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }
}
