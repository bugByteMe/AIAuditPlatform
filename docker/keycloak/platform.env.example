# Copy outside Git into a protected file. Empty required secrets fail validation.
# Platform service environment, NOT the standalone Keycloak container environment.
AI_AUDIT_AUTH_MODE=oidc
AI_AUDIT_OIDC_ISSUER=https://login.example.com/realms/ai-audit
AI_AUDIT_PUBLIC_URL=https://audit.example.com
AI_AUDIT_OIDC_CLIENT_ID=ai-audit-main
AI_AUDIT_OIDC_CLIENT_SECRET=
AI_AUDIT_OIDC_DEFAULT_GROUP_ID=
AI_AUDIT_OIDC_REVALIDATE_SECONDS=300
AI_AUDIT_REGISTRATION_PAUSED=true

# Main only. Dedicated deployments must remove these two admin settings.
AI_AUDIT_KEYCLOAK_ADMIN_CLIENT_ID=ai-audit-provisioner
AI_AUDIT_KEYCLOAK_ADMIN_CLIENT_SECRET=
AI_AUDIT_IDENTITY_CLIENTS_JSON={}

# Dedicated only: fixed customer, trusted main HTTPS origin, scoped service token.
AI_AUDIT_DEPLOYMENT_CUSTOMER_ID=
AI_AUDIT_IDENTITY_CENTRAL_URL=
AI_AUDIT_IDENTITY_CENTRAL_TOKEN=

# Configure normal AI_AUDIT_MICU_MANAGEMENT_TOKEN and AI_AUDIT_MICU_USER_ID
# on main AND dedicated instances for direct provider balance checks.
# Reuse the correct existing database/storage environment; never start against
# an empty default database when intending to migrate existing accounts.
